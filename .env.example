# ----------------------------------------------------------------------------
# Vibespot Telegram bot — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# Telegram bot token from @BotFather (format: 1234567890:AA...)
TELEGRAM_BOT_TOKEN=

# Vercel API token (https://vercel.com/account/tokens), scoped to the team below.
VERCEL_TOKEN=

# Vercel team id that owns the Vibespot projects (starts with "team_").
VERCEL_TEAM_ID=

# Webhook secret for the Vercel deployment: a random string Telegram echoes on
# every webhook call so only Telegram can reach the bot. Not needed for local
# long polling. Generate e.g. with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram numeric user ids allowed to DM the bot; these are
# also the maintainers, the only ones who may change the model, effort or
# memory. Send /whoami to the bot to learn your id.
# LEAVE THIS EMPTY ONLY FOR LOCAL TESTING: empty means anyone who finds the bot
# can use it and spend the OpenRouter budget. Setting it also closes off every
# group that is not listed in VIBY_ALLOWED_CHAT_IDS below.
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# ----------------------------------------------------------------------------
# Viby — the AI assistant
# ----------------------------------------------------------------------------

# OpenRouter API key (https://openrouter.ai/keys). Rotate if it ever leaks.
OPENROUTER_API_KEY=

# GitHub fine-grained PAT, read-only, scoped to exactly:
#   shkarsmode/vibespot-webclient-public and shkarsmode/vibespot-landing-v2
# Permissions: Contents = Read-only, Metadata = Read-only. Nothing else.
GITHUB_TOKEN=

# Azure DevOps personal access token, scoped to organisation "fwollo",
# Code = Read ONLY. Serves the two repos that do not live on GitHub: the React
# Native mobile client and the team wiki.
# OPTIONAL: leave it empty and those two repos are simply not registered — the
# bot keeps working on the GitHub repos rather than failing to start.
AZURE_DEVOPS_PAT=

# Upstash Redis (REST). Provisioned through the Vercel Marketplace under the
# wondrlink team; the integration injects these automatically on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: OpenRouter model id used until a chat picks another with /model.
# Default: anthropic/claude-haiku-4.5 (cheap and strong at code).
VIBY_DEFAULT_MODEL=

# Optional: max AI answers per chat per UTC day. Default 100.
VIBY_DAILY_CALL_LIMIT=

# Comma-separated group chat ids the bot serves. Group ids are NEGATIVE — keep
# the minus sign. Run /whoami inside the group to read its id. Every member of
# a listed group may ask questions; only ALLOWED_USER_IDS may retune the bot.
# Empty means "no groups at all" as soon as ALLOWED_USER_IDS is set.
VIBY_ALLOWED_CHAT_IDS=

# THE PHASE GATE. While this is false, Viby is completely silent in EVERY group,
# listed or not: no commands, no triggers, no message capture, no introduction.
# Listing a group above therefore stays inert until this flips. Flip it only
# after DM testing passes and BotFather privacy mode has been disabled.
VIBY_GROUP_ENABLED=false
