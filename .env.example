# ----------------------------------------------------------------------------
# Vibespot Telegram bot — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# Telegram bot token from @BotFather (format: 1234567890:AA...)
TELEGRAM_BOT_TOKEN=

# Vercel API token (https://vercel.com/account/tokens), scoped to the team below.
VERCEL_TOKEN=

# Vercel team id that owns the Vibespot projects (starts with "team_").
VERCEL_TEAM_ID=

# Webhook secret for the Vercel deployment: a random string Telegram echoes on
# every webhook call so only Telegram can reach the bot. Not needed for local
# long polling. Generate e.g. with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional: comma-separated Telegram numeric user ids allowed to use the bot.
# Leave empty to allow everyone (fine for local testing).
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# ----------------------------------------------------------------------------
# Viby — the AI assistant
# ----------------------------------------------------------------------------

# OpenRouter API key (https://openrouter.ai/keys). Rotate if it ever leaks.
OPENROUTER_API_KEY=

# GitHub fine-grained PAT, read-only, scoped to exactly:
#   shkarsmode/vibespot-webclient-public and shkarsmode/vibespot-landing-v2
# Permissions: Contents = Read-only, Metadata = Read-only. Nothing else.
GITHUB_TOKEN=

# Upstash Redis (REST). Provisioned through the Vercel Marketplace under the
# wondrlink team; the integration injects these automatically on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: OpenRouter model id used until a chat picks another with /model.
# Default: anthropic/claude-haiku-4.5 (cheap and strong at code).
VIBY_DEFAULT_MODEL=

# Optional: max AI answers per chat per UTC day. Default 100.
VIBY_DAILY_CALL_LIMIT=

# Optional: comma-separated chat ids allowed to use the AI (group ids are
# negative). Empty = any chat that already passes ALLOWED_USER_IDS.
VIBY_ALLOWED_CHAT_IDS=

# THE PHASE GATE. While this is false, Viby is completely silent in groups:
# no triggers, no message capture, no introduction. Flip to true only after
# DM testing passes and BotFather privacy mode has been disabled.
VIBY_GROUP_ENABLED=false
