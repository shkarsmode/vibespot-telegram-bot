# ----------------------------------------------------------------------------
# Vibespot Telegram bot — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# Telegram bot token from @BotFather (format: 1234567890:AA...)
TELEGRAM_BOT_TOKEN=

# Vercel API token (https://vercel.com/account/tokens), scoped to the team below.
VERCEL_TOKEN=

# Vercel team id that owns the Vibespot projects (starts with "team_").
VERCEL_TEAM_ID=

# Optional: comma-separated Telegram numeric user ids allowed to use the bot.
# Leave empty to allow everyone (fine for local testing).
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=
